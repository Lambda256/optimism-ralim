+# VENDORED — do not edit by hand beyond the `ralim:` marked lines.
+#
+# A copy of reth-tasks from the base tag's pinned reth (see rust/Cargo.toml),
+# carrying one change: the SCHED_IDLE `sched_param` initializer builds on musl
+# as well as glibc, so this fork can produce a static binary. Upstream reth does
+# not support musl targets. Wired in by the `[patch]` section of
+# rust/Cargo.toml. Re-vendor on a reth bump with
+# ./ralim/vendor-reth-crate.sh reth-tasks — see ralim/README.md.
+
 [package]
 name = "reth-tasks"
-version.workspace = true
+# Must equal the upstream crate version, or `[patch]` in rust/Cargo.toml is rejected.
+version = "2.3.0"
 edition.workspace = true
 rust-version.workspace = true
 license.workspace = true
@@ -25,7 +35,10 @@
 dashmap.workspace = true
 parking_lot.workspace = true
 thread-priority.workspace = true
-tracing.workspace = true
+# ralim: reth's workspace pins tracing with the `attributes` feature and this crate
+# uses #[tracing::instrument]; ours does not, so ask for it here rather than relying
+# on another crate in the graph to unify it in.
+tracing = { workspace = true, features = ["attributes"] }
 thiserror.workspace = true
 
