#!/bin/sh
# Fork-owned pre-push hook. `core.hooksPath` points here (see setup-clone.sh)
# rather than at upstream's .githooks/, so that the fork guard lives entirely in
# fork-owned files and the ralim patch stack stays portable across base tags —
# older tags may not have .githooks/ at all.
#
# git passes the remote name as $1 and its URL as $2, and the pushed refs on
# stdin. stdin is read once here and replayed to upstream's hook, which needs it
# too.

repo=$(git rev-parse --show-toplevel)

# --- fork guard ------------------------------------------------------------
# This clone is Lambda256/optimism-ralim and must never push to (and therefore
# never open a PR against) ethereum-optimism/optimism. See ralim/README.md.
case "${1-} ${2-}" in
  upstream\ * | *ethereum-optimism/*)
    echo "pre-push: refusing to push to '${1-}' (${2-})." >&2
    echo "  This fork never pushes to ethereum-optimism/optimism; push to 'origin' instead." >&2
    echo "  See ralim/README.md." >&2
    exit 1
    ;;
esac

refs=$(cat)

# --- fork patch integrity --------------------------------------------------
# The [patch] in rust/Cargo.toml goes inert *silently* if its key stops matching
# the pinned reth source — cargo warns and builds against upstream instead,
# taking the P2P download rate limiter with it. Only worth checking when the push
# actually touches the Rust workspace's wiring.
rust_wiring_touched=0
while read -r _ local_sha _ remote_sha; do
  [ -z "$local_sha" ] && continue
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue # branch deletion
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    base=$(git merge-base "$local_sha" origin/ralim 2>/dev/null)
    range="${base:+$base..}$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi
  if git diff --name-only $range 2>/dev/null | grep -qE '^rust/(Cargo\.toml|ralim/)'; then
    rust_wiring_touched=1
  fi
done <<EOF
$refs
EOF

if [ "$rust_wiring_touched" -eq 1 ] && [ -x "$repo/ralim/check-patches.sh" ]; then
  if ! "$repo/ralim/check-patches.sh" >/dev/null 2>&1; then
    echo "pre-push: ralim/check-patches.sh failed — the fork's [patch] is not active," >&2
    echo "  which means the P2P download rate limiter is not compiled in." >&2
    echo "  Run ./ralim/check-patches.sh for details. See ralim/README.md." >&2
    exit 1
  fi
fi

# --- upstream's own hook ---------------------------------------------------
# Whatever the base tag ships (currently a Rust fmt gate), fed the refs read
# above. Absent on older tags, in which case we are done.
if [ -x "$repo/.githooks/pre-push" ]; then
  printf '%s\n' "$refs" | "$repo/.githooks/pre-push" "$@"
  exit $?
fi
