{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push upstream:*)",
      "Bash(gh pr create --repo ethereum-optimism/optimism:*)",
      "Bash(gh pr merge --repo ethereum-optimism/optimism:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/ralim/hooks/block-upstream-pr.py\""
          }
        ]
      }
    ]
  }
}
